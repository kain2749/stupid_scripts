#!/usr/bin/env bash
set -euo pipefail

HEADPHONES="alsa_output.pci-0000_00_1f.3.analog-stereo"
TV="alsa_output.pci-0000_03_00.1.hdmi-stereo-extra4"

current="$(pactl get-default-sink)"

if [[ "$current" == "$TV" ]]; then
  target="$HEADPHONES"
else
  target="$TV"
fi

pactl set-default-sink "$target"

pactl list short sink-inputs | awk '{print $1}' | while read -r input; do
  pactl move-sink-input "$input" "$target" >/dev/null 2>&1 || true
done
