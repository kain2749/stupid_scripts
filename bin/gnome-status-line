#!/usr/bin/env bash

sensors_out="$(sensors 2>/dev/null)"

# CPU package temperature
cpu="$(
  awk '/Package id 0:/ {
    gsub(/[+°C]/, "", $4)
    printf "%.0f", $4
    exit
  }' <<< "$sensors_out"
)"

# GPU junction temperature
gpu="$(
  awk '/^junction:/ {
    gsub(/[+°C]/, "", $2)
    printf "%.0f", $2
    exit
  }' <<< "$sensors_out"
)"

# Available system RAM in GiB
ram_avail="$(
  awk '/MemAvailable:/ {
    printf "%.0f", $2 / 1024 / 1024
  }' /proc/meminfo
)"

# Find AMD GPU sysfs device
gpu_dev=""

for d in /sys/class/drm/card*/device; do
  [ -f "$d/vendor" ] || continue
  [ -f "$d/mem_info_vram_used" ] || continue
  [ -f "$d/mem_info_vram_total" ] || continue

  if [ "$(cat "$d/vendor")" = "0x1002" ]; then
    gpu_dev="$d"
    break
  fi
done

# Available VRAM in GiB
vram_avail="?"

if [ -n "$gpu_dev" ]; then
  used="$(cat "$gpu_dev/mem_info_vram_used")"
  total="$(cat "$gpu_dev/mem_info_vram_total")"

  vram_avail="$(
    awk -v u="$used" -v t="$total" 'BEGIN {
      printf "%.1f", (t - u) / 1024 / 1024 / 1024
    }'
  )"
fi

list_gsconnect_device_paths() {
  gdbus call --session \
    --dest org.gnome.Shell.Extensions.GSConnect \
    --object-path /org/gnome/Shell/Extensions/GSConnect \
    --method org.freedesktop.DBus.ObjectManager.GetManagedObjects \
    2>/dev/null |
    grep -oE "/org/gnome/Shell/Extensions/GSConnect/Device/[A-Za-z0-9_-]+" |
    sort -u
}

get_gsconnect_phone_battery() {
  local device_path
  local battery_action
  local percent

  while read -r device_path; do
    [ -n "$device_path" ] || continue

    battery_action="$(
      gdbus call --session \
        --dest org.gnome.Shell.Extensions.GSConnect \
        --object-path "$device_path" \
        --method org.gtk.Actions.Describe battery \
        2>/dev/null
    )"

    percent="$(
      grep -oE "'battery[^']*', [0-9]+" <<< "$battery_action" |
        grep -oE '[0-9]+$' |
        head -n1
    )"

    if [ -n "$percent" ]; then
      printf "%s" "$percent"
      return 0
    fi
  done < <(list_gsconnect_device_paths)

  return 1
}

phone="$(get_gsconnect_phone_battery)"
[ -z "$phone" ] && phone="?"

# PS5 DualSense controller battery
ps5=$(cat /sys/class/power_supply/ps-controller-battery-*/capacity 2>/dev/null)
ps5=${ps5:-?}

printf "CPU %s° | GPU %s° | VRAM %sG | RAM %sG | 📱%s%% | 🎮%s%%\n" \
  "${cpu:-?}" \
  "${gpu:-?}" \
  "${vram_avail:-?}" \
  "${ram_avail:-?}" \
  "${phone:-?}" \
  "${ps5:-?}"
