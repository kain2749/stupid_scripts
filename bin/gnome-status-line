#!/usr/bin/env bash

sensors_out="$(sensors 2>/dev/null)"

#cpu temp, getting package cause... i dunno, there's a lot of cores and that
#can be intimidating. what, do i take their average or something? does
#package already do that? whatever
cpu="$(
  awk '/Package id 0:/ {
    gsub(/[+°C]/, "", $4)
    printf "%.0f", $4
    exit
  }' <<< "$sensors_out"
)"

#gpu temp, getting junction for most paranoid temp
gpu="$(
  awk '/^junction:/ {
    gsub(/[+°C]/, "", $2)
    printf "%.0f", $2
    exit
  }' <<< "$sensors_out"
)"

ram_avail="$(
  free -b | awk '/^Mem:/ {
    printf "%.0f", $7 / 1024 / 1024 / 1024
  }'
)"

#this is useful in case if ollama hangs or something and i randomly
#lose 5GB of VRAM. i kinda like to know when that is a thing
gpu_dev=""
for d in /sys/class/drm/card*/device; do
  [ -f "$d/vendor" ] || continue
  [ -f "$d/mem_info_vram_used" ] || continue
  [ -f "$d/mem_info_vram_total" ] || continue

  if [ "$(cat "$d/vendor")" = "0x1002" ]; then
    gpu_dev="$d"
    break
  fi
done

#oh, maybe i should've put that comment here. let's pretend like i did
vram_avail="?"
if [ -n "$gpu_dev" ]; then
  used="$(cat "$gpu_dev/mem_info_vram_used")"
  total="$(cat "$gpu_dev/mem_info_vram_total")"
  vram_avail="$(
    awk -v u="$used" -v t="$total" 'BEGIN {
      printf "%.1f", (t - u) / 1024 / 1024 / 1024
    }'
  )"
fi

#so, i don't actually care about my storage space free, but it seemed
#like something i should include here
ssd_avail="$(df -h / | awk 'NR==2 {print $4}')"

#my ps5 controller battery
controller="$(
  upower -i "$(upower -e | grep -Ei 'controller|dualsense|sony' | head -n1)" 2>/dev/null \
    | awk -F': *' '/percentage:/ {gsub("%","",$2); print $2; exit}'
)"

[ -z "$controller" ] && controller="?"

DEST="org.gnome.Shell.Extensions.GSConnect"
DEV="/org/gnome/Shell/Extensions/GSConnect/Device/23d71c094298493ca8651dfdeed132c3"

phone="$(
  gdbus call --session \
    --dest "$DEST" \
    --object-path "$DEV" \
    --method org.gtk.Actions.Describe battery 2>/dev/null \
  | grep -oE "'battery[^']*', [0-9]+" \
  | grep -oE '[0-9]+$'
)"

[ -z "$phone" ] && phone="?"

printf "CPU %s° | GPU %s° | VRAM %sG | RAM %sG | SSD %s | 🎮%s%% | 📱%s%%\n" \
  "${cpu:-?}" "${gpu:-?}" "$vram_avail" "$ram_avail" "$ssd_avail" "$controller" "$phone"
